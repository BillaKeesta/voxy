layout(binding = TRAVERSAL_SECTION_METADATA_BUFFER_BINDING, std430) readonly restrict buffer TraversalSectionMetadataBuffer {
    SectionMeta traversalSectionData[];
};

layout(binding = TRAVERSAL_DEBUG_BINDING, std430) restrict buffer TraversalDebugBuffer {
    uint traversalDebug[];
};

const uint TRACE_RENDER_DISTANCE = 1u;
const uint TRACE_FRUSTUM = 2u;
const uint TRACE_HIZ = 3u;
const uint TRACE_DESCEND_CHILDREN = 4u;
const uint TRACE_REQUEST_FALLBACK_RENDER = 5u;
const uint TRACE_RENDER_MESH = 6u;
const uint TRACE_REQUEST_DESCEND = 7u;
const uint TRACE_MESH_POS_MISMATCH = 8u;
const uint TRACE_MESH_ID_OOB = 9u;

bool recordTraversalTrace(uint code, in UnpackedNode node, uint a, uint b, uint c) {
    atomicAdd(traversalDebug[code], 1u);
    uint base = 16u + code * TRAVERSAL_TRACE_SAMPLE_STRIDE;
    if (atomicCompSwap(traversalDebug[base], 0u, 1u) == 0u) {
        traversalDebug[base + 1u] = node.nodeId;
        traversalDebug[base + 2u] = node.rawPos.x;
        traversalDebug[base + 3u] = node.rawPos.y;
        traversalDebug[base + 4u] = uint(node.pos.x);
        traversalDebug[base + 5u] = uint(node.pos.y);
        traversalDebug[base + 6u] = uint(node.pos.z);
        traversalDebug[base + 7u] = node.lodLevel;
        traversalDebug[base + 8u] = node.meshPtr;
        traversalDebug[base + 9u] = node.childPtr;
        traversalDebug[base + 10u] = node.flags;
        traversalDebug[base + 11u] = floatBitsToUint(_screenSize);
        traversalDebug[base + 12u] = floatBitsToUint(minSSS);
        traversalDebug[base + 13u] = a;
        traversalDebug[base + 14u] = b;
        traversalDebug[base + 15u] = c;
        return true;
    }
    return false;
}

#ifdef VOXY_HIZ_TRACE
void recordHizTraversalTrace(in UnpackedNode node) {
    uint pointSample = floatBitsToUint(_hizPointSample);
    uint minDepth = floatBitsToUint(_minBB.z);
    uint mipLevel = floatBitsToUint(_hizMipLevel);
    if (recordTraversalTrace(TRACE_HIZ, node, pointSample, minDepth, mipLevel)) {
        uint base = 16u + TRACE_HIZ * TRAVERSAL_TRACE_SAMPLE_STRIDE;
        traversalDebug[base + 16u] = floatBitsToUint(_minBB.x);
        traversalDebug[base + 17u] = floatBitsToUint(_minBB.y);
        traversalDebug[base + 18u] = floatBitsToUint(_minBB.z);
        traversalDebug[base + 19u] = floatBitsToUint(_maxBB.x);
        traversalDebug[base + 20u] = floatBitsToUint(_maxBB.y);
        traversalDebug[base + 21u] = floatBitsToUint(_maxBB.z);
        traversalDebug[base + 22u] = pointSample;
        traversalDebug[base + 23u] = floatBitsToUint(_hizDepthMargin);
        traversalDebug[base + 24u] = mipLevel;
        traversalDebug[base + 25u] = packedHizSize;
        traversalDebug[base + 26u] = uint(_hizLevelSize.x);
        traversalDebug[base + 27u] = uint(_hizLevelSize.y);
        traversalDebug[base + 28u] = uint(_hizMinTexel.x);
        traversalDebug[base + 29u] = uint(_hizMinTexel.y);
        traversalDebug[base + 30u] = uint(_hizMaxTexel.x);
        traversalDebug[base + 31u] = uint(_hizMaxTexel.y);
    }
}
#endif

void validateNodeMeshMapping(in UnpackedNode node) {
    if (isEmptyMesh(node)) {
        return;
    }
    uint mesh = getMesh(node);
    if (mesh >= VOXY_TRAVERSAL_TRACE_MAX_SECTIONS) {
        recordTraversalTrace(TRACE_MESH_ID_OOB, node, mesh, VOXY_TRAVERSAL_TRACE_MAX_SECTIONS, 0u);
        return;
    }

    uvec2 meshRawPos = extractRawPos(traversalSectionData[mesh]);
    if (meshRawPos.x != node.rawPos.x || meshRawPos.y != node.rawPos.y) {
        recordTraversalTrace(TRACE_MESH_POS_MISMATCH, node, meshRawPos.x, meshRawPos.y, mesh);
    }
}
#endif

//SIMPLE_QUEUE(uvec2, requestQueue, REQUEST_QUEUE_BINDING);
layout(binding = REQUEST_QUEUE_BINDING, std430) restrict buffer requestQueueStruct {
    uvec2 requestQueueIndex;
    uvec2[] requestQueue;
};

//SIMPLE_QUEUE(uint, renderQueue, RENDER_QUEUE_BINDING);
layout(binding = RENDER_QUEUE_BINDING, std430) restrict buffer renderQueueStruct {
    uint renderQueueIndex;
    uint[] renderQueue;
};

layout(binding = RENDER_TRACKER_BINDING, std430) restrict writeonly buffer renderTrackerArray {
    uint[] lastRenderFrame;
};

#ifdef HAS_STATISTICS
layout(binding = STATISTICS_BUFFER_BINDING, std430) restrict buffer statisticsBuffer {
    uint traversalCounts[MAX_ITERATIONS];
    uint renderCounts[MAX_ITERATIONS];
};
#endif

void addRequest(inout UnpackedNode node) {
    //printf("Put node decend request");
    if (!hasRequested(node)) {
        if (requestQueueIndex.x < requestQueueSize) {//Soft limit
            uint atomRes = atomicAdd(requestQueueIndex.x, 1);
            if (atomRes < MAX_REQUEST_QUEUE_SIZE) {//Hard limit
                //Mark node as having a request submitted to prevent duplicate submissions
                requestQueue[atomRes] = getRawPos(node);
                markRequested(node);
            }
        }
    }
}

void enqueueChildren(in UnpackedNode node) {
    if (childListIsEmpty(node)) {//Occures in a very rare case/instance so just handle it gracefully
        return;
    }

    uint children = getChildCount(node);
    pushNodesInit(children);
    uint ptr = getChildPtr(node);
    for (int i = 0; i < children; i++) {
        pushNode(ptr+i);
    }
}

void enqueueSelfForRender(in UnpackedNode node) {
    //printf("render %d@[%d,%d,%d]", node.lodLevel, node.pos.x, node.pos.y, node.pos.z);
    if (renderQueueIndex < renderQueueMaxSize) {
        lastRenderFrame[getId(node)] = frameId;
        if (!isEmptyMesh(node)) {
            #ifdef VOXY_TRAVERSAL_TRACE
            validateNodeMeshMapping(node);
            #endif

            uint renderIndex = atomicAdd(renderQueueIndex, 1);
            if (renderIndex < renderQueueMaxSize) {
                renderQueue[renderIndex] = getMesh(node);

                #ifdef IS_DEBUG
                debugRenderNodeQueue[atomicAdd(debugRenderNodeQueueIndex, 1)] = node.nodeId;
                #endif

                #ifdef HAS_STATISTICS
                atomicAdd(renderCounts[node.lodLevel], 1);
                #endif
            }
        }
    }
}


vec3 closestPointToCamera(in UnpackedNode node) {
    vec3 nPos = vec3(((node.pos<<node.lodLevel)-camSecPos)<<5)-camSubSecPos;
    float scale = 1<<(node.lodLevel+5);
    return mix(mix(vec3(0), nPos, greaterThan(nPos, vec3(0))), nPos+scale, lessThan(nPos+scale, vec3(0)));
}

vec3 furthestPointToCamera(in UnpackedNode node) {
    vec3 nPos = vec3(((node.pos<<node.lodLevel)-camSecPos)<<5)-camSubSecPos;
    float scale = 1<<(node.lodLevel+5);
    return mix(nPos+scale, mix(nPos, vec3(0), greaterThan(nPos, vec3(0))), lessThan(nPos+scale, vec3(0)));
}

bool isWithinRenderDistance(in UnpackedNode node) {
    if (renderDistance<0.0f) return true;
    vec3 close = closestPointToCamera(node);
    float xzDist = close.x*close.x+close.z*close.z;
    return xzDist <= renderDistance;
}


void traverse(in UnpackedNode node) {
    #ifdef HAS_STATISTICS
    atomicAdd(traversalCounts[node.lodLevel], 1);
    #endif

    //Compute screenspace
    setupScreenspace(node);
    //debugDumpNode(node);

    bool frustumCulled = outsideFrustum();
    bool hizCulled = false;
    if (!frustumCulled) {
        hizCulled = isCulledByHiz();
    }

    if (frustumCulled || hizCulled) {
        #ifdef VOXY_TRAVERSAL_TRACE
        if (hizCulled) {
            #ifdef VOXY_HIZ_TRACE
            recordHizTraversalTrace(node);
            #else
            recordTraversalTrace(TRACE_HIZ, node, 0u, 0u, 0u);
            #endif
        } else {
            recordTraversalTrace(TRACE_FRUSTUM, node, 0u, 0u, 0u);
        }
        #endif
        //printf("culled");
    } else {
        //It is visible, TODO: maybe do a more detailed hiz test? (or make it so that )

        //Only decend if not a root node
        if (node.lodLevel!=0 && shouldDecend()) {
            if (hasChildren(node)) {
                //printf("A");
                #ifdef VOXY_TRAVERSAL_TRACE
                recordTraversalTrace(TRACE_DESCEND_CHILDREN, node, 0u, 0u, 0u);
                #endif
                enqueueChildren(node);
            } else {
                //printf("B");
                addRequest(node);
                //TODO: use self mesh (is error state if it doesnt have one since all leaf nodes should have a mesh)
                // Basicly guarenteed to have a mesh, if it doesnt it is very very bad and incorect since its a violation of the graph properties
                // that all leaf nodes must contain a mesh

                bool shouldRenderSelf = renderDistance<0.0f;
                if (!shouldRenderSelf) {
                    vec3 far = furthestPointToCamera(node);
                    shouldRenderSelf = (far.x*far.x+far.z*far.z+(16*16*16))<=renderDistance;//the +16*16 is to add some buffer room
                }

                if (shouldRenderSelf) {
                    #ifdef VOXY_TRAVERSAL_TRACE
                    recordTraversalTrace(TRACE_REQUEST_FALLBACK_RENDER, node, 1u, 0u, 0u);
                    #endif
                    enqueueSelfForRender(node);
                } else {
                    #ifdef VOXY_TRAVERSAL_TRACE
                    recordTraversalTrace(TRACE_REQUEST_FALLBACK_RENDER, node, 0u, 0u, 0u);
                    #endif
                }
            }
        } else {
            if (hasMesh(node)) {
                //printf("C");
                #ifdef VOXY_TRAVERSAL_TRACE
                recordTraversalTrace(TRACE_RENDER_MESH, node, 0u, 0u, 0u);
                #endif
                enqueueSelfForRender(node);
            } else {
                //printf("D");
                //!! not ideal, we want to render this mesh but dont have it. If we havent sent a request
                // then send a request for a mesh for this node.
                addRequest(node);

                //TODO: Decend into children? maybe add a bitflag saying is bad if the immediate children dont have meshes
                if (node.lodLevel != 0) {
                    #ifdef VOXY_TRAVERSAL_TRACE
                    recordTraversalTrace(TRACE_REQUEST_DESCEND, node, 1u, 0u, 0u);
                    #endif
                    enqueueChildren(node);
                } else {
                    #ifdef VOXY_TRAVERSAL_TRACE
                    recordTraversalTrace(TRACE_REQUEST_DESCEND, node, 0u, 0u, 0u);
                    #endif
                }
            }
        }
    }
}

void main() {
    uint nodeId = getCurrentNode();
    if (nodeId != SENTINAL_OUT_OF_BOUNDS) {
        //Fetch + decode node
        UnpackedNode node;
        unpackNode(node, nodeId);

        //Check if were inside the render distastance before traversince
        if (isWithinRenderDistance(node)) {
            traverse(node);
        } else {
            #ifdef VOXY_TRAVERSAL_TRACE
            recordTraversalTrace(TRACE_RENDER_DISTANCE, node, 0u, 0u, 0u);
            #endif
        }

        /*
